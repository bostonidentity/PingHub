{
  "name": "aic-studio",
  "displayName": "AIC Studio for Ping Advanced Identity Cloud",
  "description": "Manage Ping AIC tenant configurations — pull, push, promote, and diff across environments.",
  "version": "0.1.0",
  "publisher": "bostonidentity",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bostonidentity/PingHub.git",
    "directory": "aic-studio"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ping",
    "aic",
    "identity cloud",
    "forgerock",
    "pinghub"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aic-studio",
          "title": "PingHub AIC Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aic-studio": [
        {
          "id": "aic-studio.environments",
          "name": "Environments"
        },
        {
          "id": "aic-studio.promotionTasks",
          "name": "Promotion Tasks"
        },
        {
          "id": "aic-studio.history",
          "name": "History"
        },
        {
          "id": "aic-studio.monitors",
          "name": "Monitors"
        },
        {
          "id": "aic-studio.logs",
          "name": "Logs"
        }
      ]
    },
    "commands": [
      {
        "command": "aic-studio.env.add",
        "title": "AIC Studio: Add environment…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.env.setActive",
        "title": "AIC Studio: Set active environment…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.env.remove",
        "title": "AIC Studio: Remove environment…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.sync.pull",
        "title": "AIC Studio: Pull from environment",
        "category": "AIC Studio",
        "icon": "$(sync)"
      },
      {
        "command": "aic-studio.compare.withEnv",
        "title": "AIC Studio: Compare with environment…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.sync.push",
        "title": "AIC Studio: Push to environment…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.promote.addToTask",
        "title": "AIC Studio: Add to promotion task…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.promote.runTask",
        "title": "AIC Studio: Run promotion task…",
        "category": "AIC Studio",
        "icon": "$(rocket)"
      },
      {
        "command": "aic-studio.promote.archiveTask",
        "title": "AIC Studio: Archive promotion task…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.compare.withRevision",
        "title": "AIC Studio: Compare with revision…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.compare.pickEnvs",
        "title": "AIC Studio: Compare envs (pick two)…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.history.openDetails",
        "title": "AIC Studio: Show operation details",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.promote.removeItem",
        "title": "AIC Studio: Remove item from promotion task",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.promote.deleteTask",
        "title": "AIC Studio: Delete promotion task…",
        "category": "AIC Studio"
      },
      {
        "command": "aic-studio.federation.openEditor",
        "title": "AIC Studio: Open federation editor",
        "category": "AIC Studio",
        "icon": "$(edit)"
      },
      {
        "command": "aic-studio.monitor.pollNow",
        "title": "AIC Studio: Poll monitors now",
        "category": "AIC Studio",
        "icon": "$(sync)"
      },
      {
        "command": "aic-studio.monitor.openDashboard",
        "title": "AIC Studio: Open monitor dashboard",
        "category": "AIC Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "aic-studio.monitor.acknowledgeAlert",
        "title": "AIC Studio: Acknowledge alert",
        "category": "AIC Studio"
      }
      ,
      { "command": "aic-studio.logs.openQueryEditor", "title": "AIC Studio: Open log query editor…", "category": "AIC Studio", "icon": "$(search)" },
      { "command": "aic-studio.logs.runSavedQuery", "title": "AIC Studio: Run saved log query", "category": "AIC Studio" },
      { "command": "aic-studio.logs.deleteSavedQuery", "title": "AIC Studio: Delete saved log query…", "category": "AIC Studio" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aic-studio.env.add",
          "when": "view == aic-studio.environments",
          "group": "navigation@1"
        },
        {
          "command": "aic-studio.sync.pull",
          "when": "view == aic-studio.environments",
          "group": "navigation@2"
        },
        {
          "command": "aic-studio.monitor.pollNow",
          "when": "view == aic-studio.monitors",
          "group": "navigation@1"
        },
        {
          "command": "aic-studio.monitor.openDashboard",
          "when": "view == aic-studio.monitors",
          "group": "navigation@2"
        }
        ,
        { "command": "aic-studio.logs.openQueryEditor", "when": "view == aic-studio.logs", "group": "navigation" }
      ],
      "view/item/context": [
        {
          "command": "aic-studio.sync.pull",
          "when": "viewItem == aic-studio.env",
          "group": "inline"
        },
        {
          "command": "aic-studio.compare.withEnv",
          "when": "viewItem == aic-studio.journey",
          "group": "1_compare"
        },
        {
          "command": "aic-studio.sync.push",
          "when": "viewItem == aic-studio.journey",
          "group": "1_compare"
        },
        {
          "command": "aic-studio.promote.addToTask",
          "when": "viewItem == aic-studio.journey",
          "group": "2_promote"
        },
        {
          "command": "aic-studio.promote.runTask",
          "when": "viewItem == aic-studio.promotionTask",
          "group": "inline"
        },
        {
          "command": "aic-studio.promote.archiveTask",
          "when": "viewItem == aic-studio.promotionTask",
          "group": "2_archive"
        },
        {
          "command": "aic-studio.compare.withRevision",
          "when": "viewItem == aic-studio.journey",
          "group": "1_compare"
        },
        {
          "command": "aic-studio.promote.removeItem",
          "when": "viewItem == aic-studio.promotionTaskItem",
          "group": "inline"
        },
        {
          "command": "aic-studio.promote.deleteTask",
          "when": "viewItem == aic-studio.promotionTask || viewItem == aic-studio.archivedTask",
          "group": "3_delete"
        },
        {
          "command": "aic-studio.federation.openEditor",
          "when": "viewItem == aic-studio.federationItem",
          "group": "inline"
        },
        {
          "command": "aic-studio.compare.withEnv",
          "when": "viewItem == aic-studio.federationItem",
          "group": "1_compare"
        },
        {
          "command": "aic-studio.promote.addToTask",
          "when": "viewItem == aic-studio.federationItem",
          "group": "2_promote"
        },
        {
          "command": "aic-studio.monitor.acknowledgeAlert",
          "when": "viewItem == aic-studio.monitorAlert",
          "group": "inline"
        }
        ,
        { "command": "aic-studio.logs.openQueryEditor", "when": "viewItem == aic-studio.logsEnv", "group": "inline" },
        { "command": "aic-studio.logs.deleteSavedQuery", "when": "viewItem == aic-studio.savedLogQuery", "group": "1_delete" }
      ]
    },
    "configuration": {
      "title": "AIC Studio",
      "properties": {
        "aic-studio.activeEnvironment": {
          "type": "string",
          "default": "",
          "description": "Name of the currently active AIC environment."
        },
        "aic-studio.monitor.tlsThresholdDays": {
          "type": "number",
          "default": 30,
          "description": "Days remaining before a TLS certificate is marked as a warning. Below 14 = error."
        },
        "aic-studio.monitor.pollIntervalMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "How often (in minutes) to run background monitor checks for each environment."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node ./out/tests/integration/runTest.js",
    "pretest:integration": "npm run build",
    "package": "vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.0.0",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "glob": "^11.0.0",
    "mocha": "^10.7.0",
    "nock": "^14.0.15",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "zod": "^3.23.0"
  }
}
