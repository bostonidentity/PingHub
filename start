#!/usr/bin/env bash
# start — bootstrap + launch PingHub in the background.
#
# After `git clone https://github.com/bostonidentity/PingHub && cd PingHub`,
# run `./start` to install dependencies, build, and launch the web UI.
# The server runs detached; logs go to ping-aic-studio/.pinghub-logs/pinghub.log.
# Browser auto-opens. Run `./stop` to stop the server.
#
# Each step is check-then-do — safe to re-run if a previous run failed
# partway through; it picks up where it left off.
#
# Pinghub-script flags:
#   --bundled-node     force download of bundled Node even if system Node is fine
#   --skip-update      don't check git for updates
#   --build            wipe .next and rebuild (keeps node_modules)
#   --reinstall        wipe node_modules + .next before bootstrapping
#
# Launcher flags forwarded to launcher.mjs:
#   --port N           override port (default 3000; auto-picks a free port if 3000 is taken)
#   --no-open          start server but don't open the browser
#   --data-dir PATH    override PINGHUB_DATA_DIR

set -euo pipefail

# Resolve the directory containing this script, following symlinks.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  link_target=$(readlink "$SCRIPT_PATH")
  case "$link_target" in
    /*) SCRIPT_PATH="$link_target" ;;
    *)  SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/$link_target" ;;
  esac
done
REPO_ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
APP_DIR="${REPO_ROOT}/ping-aic-studio"
LOG_DIR="${APP_DIR}/.pinghub-logs"
LOG_FILE="${LOG_DIR}/pinghub.log"
PID_FILE="${LOG_DIR}/pinghub.pid"

LOG_PREFIX="[Ping AIC Studio]"
step() { echo "$LOG_PREFIX $*"; }
fail() { echo "$LOG_PREFIX ERROR: $*" >&2; exit 1; }

print_help() {
  cat <<EOF
Usage: ./start [OPTIONS]

Bootstrap and launch PingHub in the background.

The script:
  1. Detects OS (macOS / Linux / Windows-MSYS)
  2. Ensures Node 20+ (bundled > system > auto-download)
  3. Runs npm install if dependencies are missing/stale
  4. Runs npm run build if no production build exists
  5. Checks git for upstream updates
  6. Launches the server in the background, opens the browser

The server runs detached — closing your terminal does not stop it.
Use './stop' to shut it down, or './status' to check if it's running.

OPTIONS
  --port N           override port (default 3000; auto-falls-back if taken)
  --data-dir PATH    override PINGHUB_DATA_DIR (default: matches \`npm run dev\`)
  --no-open          start the server without opening the browser
  --build            wipe .next and rebuild (keeps node_modules)
  --reinstall        wipe node_modules + .next before bootstrapping
  --bundled-node     force download of Node 20.18.0 (skip system Node)
  --skip-update      skip the git fetch update check
  --force-restart    if another instance is running, kill it without prompting
  -h, --help         show this help and exit

EXAMPLES
  ./start                          # default — opens browser at http://127.0.0.1:3000
  ./start --no-open                # server only, no browser
  ./start --port 8080              # custom port
  ./start --build                  # wipe .next and rebuild (keeps node_modules)
  ./start --reinstall              # wipe node_modules + .next, rebuild
  ./start --bundled-node           # use pinned Node 20.18.0 (download if absent)

RELATED
  ./stop      stop the running server
  ./status    show whether the server is currently running
EOF
}

# ── Parse flags ─────────────────────────────────────────────────────
BUNDLED_NODE=0
SKIP_UPDATE=0
REINSTALL=0
REBUILD=0
FORCE_RESTART=0
LAUNCHER_ARGS=()
for arg in "$@"; do
  case "$arg" in
    -h|--help)        print_help; exit 0 ;;
    --bundled-node)   BUNDLED_NODE=1 ;;
    --skip-update)    SKIP_UPDATE=1 ;;
    --reinstall)      REINSTALL=1 ;;
    --build)          REBUILD=1 ;;
    --force-restart)  FORCE_RESTART=1 ;;
    *)                LAUNCHER_ARGS+=("$arg") ;;
  esac
done

# ── Helpers used by both the pre-launch "already running?" gate and
#    the build-time auto-recovery path. Defined early so the gate can
#    call them before we touch Node or the build dir.
# ───────────────────────────────────────────────────────────────────────

# Print space-separated PIDs of every Ping AIC Studio standalone server
# on this machine (matches any .next/standalone/server.js path, so
# sibling clones are caught too). Empty if none.
find_standalone_pids() {
  local pids=""
  if command -v pgrep >/dev/null 2>&1; then
    pids=$(pgrep -f 'standalone[/\\]server\.js' 2>/dev/null || true)
  elif command -v ps >/dev/null 2>&1; then
    pids=$(ps -eo pid,args 2>/dev/null \
      | awk '/standalone[\/\\]server\.js/{print $1}' || true)
  fi
  echo "$pids" | tr '\n' ' ' | sed 's/[[:space:]]\+$//'
}

# Kill a space-separated list of PIDs: TERM, wait 1s, then KILL.
kill_pids() {
  local pids="$1"
  [ -z "$pids" ] && return 0
  for p in $pids; do kill "$p" 2>/dev/null || true; done
  sleep 1
  for p in $pids; do kill -9 "$p" 2>/dev/null || true; done
  sleep 1
}

# Auto-recovery: kill any Ping AIC Studio standalone server holding
# .next/standalone/* file locks (caught by find_standalone_pids).
kill_orphan_standalone() {
  local pids
  pids=$(find_standalone_pids)
  [ -z "$pids" ] && return 0
  step "found standalone server PID(s): $pids — terminating"
  kill_pids "$pids"
  rm -f "$PID_FILE" 2>/dev/null || true
}

# ── Already running? Offer to stop running instances and continue. ──
TRACKED_PID=""
if [ -f "$PID_FILE" ]; then
  TRACKED_PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$TRACKED_PID" ] && ! kill -0 "$TRACKED_PID" 2>/dev/null; then
    step "found stale PID file (PID $TRACKED_PID is not running) — cleaning up"
    rm -f "$PID_FILE"
    TRACKED_PID=""
  fi
fi

ALL_PIDS=$(find_standalone_pids)

# Anything to report?
if [ -n "$TRACKED_PID" ] || [ -n "$ALL_PIDS" ]; then
  echo "$LOG_PREFIX Ping AIC Studio is already running:"
  if [ -n "$TRACKED_PID" ]; then
    EXISTING_URL=""
    if [ -f "$LOG_FILE" ]; then
      EXISTING_URL=$(grep "ready at " "$LOG_FILE" | tail -1 | sed -E 's/.*ready at //')
    fi
    EXISTING_STARTED=$(ps -o lstart= -p "$TRACKED_PID" 2>/dev/null | sed 's/^ *//' || true)
    echo "$LOG_PREFIX   tracked PID: $TRACKED_PID"
    [ -n "$EXISTING_URL" ]     && echo "$LOG_PREFIX     serving:   $EXISTING_URL"
    [ -n "$EXISTING_STARTED" ] && echo "$LOG_PREFIX     started:   $EXISTING_STARTED"
    echo "$LOG_PREFIX     log:       $LOG_FILE"
  fi
  # Untracked = found by broad scan, minus the tracked PID.
  UNTRACKED=""
  for p in $ALL_PIDS; do
    [ "$p" = "$TRACKED_PID" ] && continue
    UNTRACKED="$UNTRACKED $p"
  done
  UNTRACKED=$(echo "$UNTRACKED" | xargs || true)
  [ -n "$UNTRACKED" ] && echo "$LOG_PREFIX   untracked standalone PID(s): $UNTRACKED"

  do_kill=0
  if [ "$FORCE_RESTART" -eq 1 ]; then
    step "--force-restart: stopping running instance(s)"
    do_kill=1
  elif [ -t 0 ] && [ -r /dev/tty ]; then
    printf "%s Stop them and start a new one? [Y/n] " "$LOG_PREFIX"
    read -r reply </dev/tty || reply=""
    case "$reply" in ""|y|Y|yes|YES) do_kill=1 ;; esac
  else
    echo "$LOG_PREFIX (non-interactive shell — refusing to auto-kill)"
    echo "$LOG_PREFIX Re-run with --force-restart, or run ./stop first."
    exit 1
  fi

  if [ "$do_kill" -ne 1 ]; then
    step "leaving running instance(s) alone; exiting"
    exit 0
  fi

  ALL=""
  [ -n "$TRACKED_PID" ] && ALL="$TRACKED_PID"
  [ -n "$UNTRACKED"   ] && ALL="$ALL $UNTRACKED"
  ALL=$(echo "$ALL" | xargs)
  step "stopping PID(s): $ALL"
  kill_pids "$ALL"
  rm -f "$PID_FILE" 2>/dev/null || true
fi

# ── 1. Detect OS ────────────────────────────────────────────────────
case "$(uname -s)" in
  Darwin)              OS="darwin" ;;
  Linux)               OS="linux" ;;
  MINGW*|MSYS*|CYGWIN*) OS="windows" ;;
  *) fail "unsupported OS: $(uname -s) — use start.cmd on native Windows" ;;
esac

case "$(uname -m)" in
  arm64|aarch64) ARCH="arm64" ;;
  x86_64|amd64)  ARCH="x64" ;;
  *) fail "unsupported architecture: $(uname -m)" ;;
esac

step "detected: ${OS}-${ARCH}"

if [ ! -d "$APP_DIR" ]; then
  fail "expected ping-aic-studio/ directory at $APP_DIR — are you inside the PingHub repo?"
fi

# ── Optional --reinstall / --build ──────────────────────────────────
# Note: wipes that hit file locks are recovered later by wipe_next();
# here we do a best-effort wipe and let the build-phase retry handle
# any leftover EBUSY/ETXTBSY.
if [ "$REINSTALL" -eq 1 ]; then
  step "--reinstall: wiping node_modules + .next"
  rm -rf "${APP_DIR}/node_modules" "${APP_DIR}/.next" 2>/dev/null || true
elif [ "$REBUILD" -eq 1 ]; then
  step "--build: wiping .next"
  rm -rf "${APP_DIR}/.next" 2>/dev/null || true
fi

# ── 2. Ensure Node 20+ ──────────────────────────────────────────────
NODE_REQ_MAJOR=20
NODE_PIN_VERSION="20.18.0"
LOCAL_NODE_DIR="${APP_DIR}/.pinghub-node"
LOCAL_NODE_BIN="${LOCAL_NODE_DIR}/bin/node"

node_major() {
  if [ -x "$1" ]; then
    "$1" -v 2>/dev/null | sed 's/^v//' | cut -d. -f1
  fi
}

download_node() {
  local arch suffix url tmp extracted
  case "$ARCH" in
    arm64) arch="arm64" ;;
    x64)   arch="x64" ;;
  esac
  case "$OS" in
    darwin)  suffix="darwin-${arch}.tar.gz" ;;
    linux)   suffix="linux-${arch}.tar.xz" ;;
    windows) suffix="win-${arch}.zip" ;;
  esac
  url="https://nodejs.org/dist/v${NODE_PIN_VERSION}/node-v${NODE_PIN_VERSION}-${suffix}"

  step "downloading Node ${NODE_PIN_VERSION} from nodejs.org..."
  tmp=$(mktemp -d)
  trap "rm -rf $tmp" RETURN

  if ! curl -fL --progress-bar "$url" -o "${tmp}/node-archive"; then
    fail "could not download Node — check network or install Node 20+ manually from https://nodejs.org"
  fi

  case "$suffix" in
    *.tar.gz|*.tar.xz)
      if ! tar -xf "${tmp}/node-archive" -C "$tmp"; then
        fail "could not extract Node archive"
      fi
      ;;
    *.zip)
      if ! unzip -q "${tmp}/node-archive" -d "$tmp"; then
        fail "could not unzip Node archive"
      fi
      ;;
  esac

  extracted=$(find "$tmp" -maxdepth 1 -mindepth 1 -type d | head -1)
  if [ -z "$extracted" ] || [ ! -x "${extracted}/bin/node" ]; then
    fail "Node binary not found in extracted archive"
  fi

  rm -rf "$LOCAL_NODE_DIR"
  mv "$extracted" "$LOCAL_NODE_DIR"
}

if [ "$BUNDLED_NODE" -eq 1 ] && [ ! -x "$LOCAL_NODE_BIN" ]; then
  download_node
fi

NODE_EXE=""
if [ -x "$LOCAL_NODE_BIN" ]; then
  major=$(node_major "$LOCAL_NODE_BIN")
  if [ -n "$major" ] && [ "$major" -ge "$NODE_REQ_MAJOR" ]; then
    NODE_EXE="$LOCAL_NODE_BIN"
    step "✓ using bundled Node $("$NODE_EXE" -v) ($LOCAL_NODE_BIN)"
  else
    step "bundled Node is too old; re-downloading..."
    download_node
    NODE_EXE="$LOCAL_NODE_BIN"
  fi
fi

if [ -z "$NODE_EXE" ] && command -v node >/dev/null 2>&1; then
  sys_node=$(command -v node)
  major=$(node_major "$sys_node")
  if [ -n "$major" ] && [ "$major" -ge "$NODE_REQ_MAJOR" ]; then
    NODE_EXE="$sys_node"
    step "✓ using system Node $("$NODE_EXE" -v) ($sys_node)"
  else
    step "found system Node $($sys_node -v 2>/dev/null) but need ${NODE_REQ_MAJOR}+; will bundle"
  fi
fi

if [ -z "$NODE_EXE" ]; then
  download_node
  NODE_EXE="$LOCAL_NODE_BIN"
  step "✓ downloaded Node $("$NODE_EXE" -v)"
fi

NPM_EXE="$(dirname "$NODE_EXE")/npm"
if [ ! -x "$NPM_EXE" ]; then
  NPM_EXE="npm"
fi
export PATH="$(dirname "$NODE_EXE"):${PATH}"

# ── 3. Check for updates (offer to pull) ────────────────────────────
if [ "$SKIP_UPDATE" -eq 0 ]; then
  cd "$REPO_ROOT"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    step "checking for updates..."
    if git fetch --quiet origin 2>/dev/null; then
      branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")
      upstream=$(git rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null || echo "")
      if [ -n "$upstream" ]; then
        ahead=$(git rev-list --count "HEAD..${upstream}" 2>/dev/null || echo "0")
        if [ "$ahead" -gt 0 ]; then
          step "⚡ ${ahead} update(s) available on ${branch} (${upstream})"
          do_pull=0
          if [ -t 0 ] && [ -r /dev/tty ]; then
            printf "%s Pull and rebuild now? [Y/n] " "$LOG_PREFIX"
            read -r reply </dev/tty || reply=""
            case "$reply" in ""|y|Y|yes|YES) do_pull=1 ;; esac
          else
            step "   (non-interactive shell — skipping; re-run with a TTY or run 'git pull')"
          fi
          if [ "$do_pull" -eq 1 ]; then
            step "pulling latest..."
            if git pull --ff-only --quiet; then
              step "✓ pulled — marking build dir for rebuild"
              # Best-effort wipe; build-phase retry handles any lock.
              rm -rf "${APP_DIR}/.next" 2>/dev/null || true
            else
              fail "git pull failed — resolve manually then re-run ./start"
            fi
          fi
        else
          step "✓ up to date"
        fi
      fi
    else
      step "(could not reach origin — skipping update check)"
    fi
    cd "$APP_DIR"
  fi
fi

# ── 4. npm install ──────────────────────────────────────────────────
cd "$APP_DIR"

deps_stale() {
  [ ! -d node_modules ] && return 0
  [ ! -f node_modules/.package-lock.json ] && return 0
  [ package.json -nt node_modules/.package-lock.json ] && return 0
  [ package-lock.json -nt node_modules/.package-lock.json ] && return 0
  return 1
}

# Wipe .next safely, retrying after killing orphans if the first
# attempt fails (typical EBUSY on Windows, stale child elsewhere).
wipe_next() {
  if rm -rf .next 2>/dev/null; then return 0; fi
  step "wipe of .next failed (file lock?) — killing orphans and retrying"
  kill_orphan_standalone
  rm -rf .next || fail "could not remove .next — close any process holding it and retry"
}

# Run `npm run build` with tiered auto-recovery.
#   1. plain build
#   2. on failure, classify from the captured log:
#      - "Cannot find module" / "Can't resolve"  -> npm install + retry
#      - "EBUSY" / "ETXTBSY" / "EPERM"           -> kill orphans + wipe + retry
#      - anything else                            -> kill orphans + wipe + retry
#   3. on second failure, full reinstall (rm node_modules + .next), retry
#   4. final failure: fail
build_with_recovery() {
  local log
  log=$(mktemp 2>/dev/null || echo "/tmp/pinghub-build-$$.log")

  _run_build() {
    set -o pipefail
    "$NPM_EXE" run build 2>&1 | tee "$log"
    local rc=${PIPESTATUS[0]}
    set +o pipefail
    return $rc
  }

  step "building app (npm run build)..."
  if _run_build; then rm -f "$log"; return 0; fi

  local cause="unknown"
  if grep -qE "Can't resolve|Cannot find module|ERR_MODULE_NOT_FOUND|MODULE_NOT_FOUND" "$log"; then
    cause="missing-dep"
  elif grep -qE "EBUSY|ETXTBSY|EPERM" "$log"; then
    cause="file-lock"
  fi

  case "$cause" in
    missing-dep)
      step "build failed: missing dependency detected — reinstalling and retrying"
      "$NPM_EXE" install || { rm -f "$log"; fail "npm install failed during recovery"; }
      ;;
    file-lock)
      step "build failed: file lock detected — killing orphans and retrying"
      kill_orphan_standalone
      wipe_next
      ;;
    *)
      step "build failed — attempting auto-recovery (kill orphans + wipe + retry)"
      kill_orphan_standalone
      wipe_next
      ;;
  esac

  step "retrying build..."
  if _run_build; then rm -f "$log"; return 0; fi

  step "build still failing — full reinstall (node_modules + .next) and final retry"
  kill_orphan_standalone
  rm -rf node_modules
  wipe_next
  "$NPM_EXE" install || { rm -f "$log"; fail "npm install failed during full reinstall"; }

  if _run_build; then rm -f "$log"; return 0; fi

  rm -f "$log"
  fail "build failed after auto-recovery — see output above"
}

if deps_stale; then
  step "installing dependencies (npm install)..."
  if ! "$NPM_EXE" install; then
    fail "npm install failed — see output above"
  fi
else
  step "✓ dependencies up to date"
fi

# ── 5. Build ────────────────────────────────────────────────────────
# Decide whether the existing .next is stale. We compute a SHA-256
# fingerprint of every build-affecting input (src, configs, package.json,
# Node major version, etc.) and compare it to the fingerprint stored next
# to the build. Any mismatch — git pull, branch switch, manual edit, dep
# bump, Node upgrade — wipes .next and rebuilds.
FP_FILE=".next/.build-fingerprint"
FP_SCRIPT="${APP_DIR}/scripts/build-fingerprint.mjs"
NEED_BUILD=0

if [ ! -f .next/standalone/server.js ]; then
  step "no existing build — will build"
  NEED_BUILD=1
elif [ ! -f "$FP_SCRIPT" ]; then
  # Older checkout without the helper — keep prior behaviour
  step "✓ build present (fingerprint script missing; skipping staleness check)"
else
  WANT_FP=$("$NODE_EXE" "$FP_SCRIPT" 2>/dev/null || echo "")
  HAVE_FP=""
  [ -f "$FP_FILE" ] && HAVE_FP=$(tr -d '\r\n' < "$FP_FILE" 2>/dev/null || true)
  if [ -z "$WANT_FP" ]; then
    step "✓ build present (could not compute fingerprint; skipping staleness check)"
  elif [ "$WANT_FP" = "$HAVE_FP" ]; then
    step "✓ build up to date (fingerprint matches)"
  else
    step "source changed since last build — wiping .next"
    wipe_next
    NEED_BUILD=1
  fi
fi

if [ "$NEED_BUILD" -eq 1 ]; then
  build_with_recovery
  # Record the fingerprint of the inputs that produced this build.
  if [ -f "$FP_SCRIPT" ]; then
    if WANT_FP=$("$NODE_EXE" "$FP_SCRIPT" 2>/dev/null) && [ -n "$WANT_FP" ]; then
      mkdir -p .next
      printf '%s' "$WANT_FP" > "$FP_FILE"
    fi
  fi
fi

# ── 6. Launch in background ─────────────────────────────────────────
mkdir -p "$LOG_DIR"
cd "$APP_DIR"

# Timestamp the log so users can find session boundaries
{
  echo ""
  echo "════════════════════════════════════════════════════════════"
  echo " Ping AIC Studio start at $(date '+%Y-%m-%d %H:%M:%S')"
  echo " node: $NODE_EXE ($("$NODE_EXE" -v))"
  echo " cwd: $APP_DIR"
  echo " args: ${LAUNCHER_ARGS[*]:-(none)}"
  echo "════════════════════════════════════════════════════════════"
} >> "$LOG_FILE"

step "launching in background..."
# nohup + & + disown survives terminal close.
# stdin /dev/null so the child doesn't try to read from the closing tty.
# Bash 3.2 (macOS default) errors on "${arr[@]}" when set -u is on and the
# array is empty. The ${arr[@]+...} expansion expands to nothing in that
# case, otherwise to the array contents.
nohup "$NODE_EXE" launcher/launcher.mjs ${LAUNCHER_ARGS[@]+"${LAUNCHER_ARGS[@]}"} \
  </dev/null >> "$LOG_FILE" 2>&1 &
SERVER_PID=$!
echo "$SERVER_PID" > "$PID_FILE"
disown "$SERVER_PID" 2>/dev/null || true

# Wait a few seconds and check it's still alive
sleep 3
if ! kill -0 "$SERVER_PID" 2>/dev/null; then
  echo "$LOG_PREFIX ✗ Ping AIC Studio failed to start. Last 30 lines of $LOG_FILE:"
  echo "────────────────────────────────────────────────────────────"
  tail -30 "$LOG_FILE"
  echo "────────────────────────────────────────────────────────────"
  rm -f "$PID_FILE"
  exit 1
fi

step "✓ Ping AIC Studio started successfully (PID $SERVER_PID)"
step "  log:  $LOG_FILE"
step "  tail: tail -f $LOG_FILE"
step "  stop: ./stop"
